# ---------------------------------------------------------------
# Sportmetryx — environment configuration (copy to .env)
# ---------------------------------------------------------------

# Neon (serverless PostgreSQL): pooled endpoint for the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require"

# Neon direct (no pooler) endpoint — used by Prisma migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/db?sslmode=require"

# Secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_HEX_STRING"

# Resend (transactional email: welcome + owner alerts). Get a key at resend.com
RESEND_API_KEY=
RESEND_FROM=

# Inbox that receives waitlist/pilot alerts (defaults to the Resend account email).
NEWSLETTER_OWNER=
