# ---------------------------------------------------------------
# Sportmetryx Football — environment configuration (copy to .env)
# ---------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (scripts/db.sh): postgres runs on 127.0.0.1:5432 with trust auth.
# Production / hosted Postgres: use a real credential and a pooled provider.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/sportmetryx_football?schema=public"

# Secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_HEX_STRING"

# Public app name shown in the UI (optional).
NEXT_PUBLIC_APP_NAME="Sportmetryx Football"

# Resend (transactional email: welcome + owner alerts). Get a key at resend.com
RESEND_API_KEY=
RESEND_FROM=
